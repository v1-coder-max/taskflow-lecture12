# Database — use 127.0.0.1 (not localhost) to avoid Windows named-pipe issues
DATABASE_URL="mysql://root:yourpassword@127.0.0.1:3306/taskmanager_auth_db"

# JWT — use a long random string (32+ characters). Never commit the real one.
JWT_SECRET=replace_this_with_a_long_random_secret_string_123456
JWT_EXPIRES_IN=1d

# bcrypt cost factor (10 is the industry default)
BCRYPT_SALT_ROUNDS=10

PORT=3000
NODE_ENV=development
